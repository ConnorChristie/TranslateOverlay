# Example local configuration file
# Copy this file to local_config.properties and replace with your actual API key
# DO NOT COMMIT local_config.properties TO SOURCE CONTROL

# OpenAI Configuration
openai.api.key=YOUR_OPENAI_API_KEY_HERE
openai.model=whisper-1
openai.temperature=0.0

# Instructions:
# 1. Copy this file: cp local_config.properties.example local_config.properties
# 2. Edit local_config.properties and replace YOUR_OPENAI_API_KEY_HERE with your actual API key
# 3. Your API key should start with 'sk-' followed by alphanumeric characters
# 4. Example: openai.api.key=sk-1234567890abcdef1234567890abcdef1234567890abcdef
# 5. The local_config.properties file is automatically excluded from git 